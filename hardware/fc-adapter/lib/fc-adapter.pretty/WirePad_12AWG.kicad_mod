(footprint "WirePad_12AWG" (version 20221018) (generator pcbnew)
  (layer "F.Cu")
  (descr "Through-hole solder pad for one 12AWG silicone lead (2.6mm hole, 5.0mm pad)")
  (tags "wire solder pad")
  (attr through_hole)
  (fp_text reference "REF**" (at 0 -3.5) (layer "F.SilkS") hide
    (effects (font (size 0.8 0.8) (thickness 0.12)))
  )
  (fp_text value "WirePad_12AWG" (at 0 3.5) (layer "F.Fab")
    (effects (font (size 0.8 0.8) (thickness 0.12)))
  )
  (fp_circle (center 0 0) (end 2.75 0) (layer "F.CrtYd") (stroke (width 0.05) (type solid)) (fill none))
  (fp_circle (center 0 0) (end 2.75 0) (layer "B.CrtYd") (stroke (width 0.05) (type solid)) (fill none))
  (pad "1" thru_hole circle (at 0 0) (size 5.0 5.0) (drill 2.6) (layers "*.Cu" "*.Mask") (zone_connect 2))
)
